## 📦 Modelli e Schemi Dati JSON

### `TmdbSearchResult`
```typescript
interface TmdbSearchResult {
  id: number;                   // ID TMDB
  title: string;                // Titolo tradotto o principale
  original_title?: string;      // Titolo originale
  media_type: "movie" | "tv";   // Tipologia
  overview?: string;            // Trama / sinossi
  poster_path?: string;         // Percorso relativo poster TMDB
  poster_url?: string;          // URL assoluto poster a 500px
  backdrop_url?: string;        // URL assoluto sfondo orizzontale a 1280px
  release_date?: string;        // Data di uscita o trasmissione
  vote_average?: number;        // Media voti TMDB (es. 8.4)
  stream_url: string;           // URL diretto EasyStream per la riproduzione
}
```

### `TvSeasonsResponse` & `SeasonItem`
```typescript
interface TvSeasonsResponse {
  tmdb_id: number;
  series_name?: string;
  seasons: SeasonItem[];
}

interface SeasonItem {
  season_number: number;        // Numero stagione (0 = speciali, 1 = stagione 1)
  name: string;                 // Nome stagione (es. "Stagione 1")
  episode_count: number;        // Conteggio episodi disponibili
}
```

### `StreamInfo`
```typescript
interface StreamInfo {
  title: string;
  source: "vixsrc" | "animeunity";
  playlist_url: string;         // URL HLS master (.m3u8)
  embed_url?: string;
  m3u8_content: string;         // Testo completo playlist M3U8
  audio: AudioTrack[];
  subtitles: SubtitleTrack[];
  qualities: QualityVariant[];
}

interface AudioTrack {
  language: string;             // Codice lingua (es. "ita", "eng")
  name: string;                 // Nome leggibile (es. "Italiano")
  url: string;                  // URL traccia audio
}

interface SubtitleTrack {
  language: string;             // Codice lingua (es. "ita")
  name: string;                 // Nome sottotitoli
  url: string;                  // URL traccia vtt / srt
}

interface QualityVariant {
  resolution?: string;          // es. "1920x1080"
  bandwidth?: number;           // Bitrate in bps
  url: string;                  // URL playlist variante
}
```

